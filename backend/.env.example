# Either set DATABASE_URL, or the five DB_* values below. DATABASE_URL wins
# when both are present, and the DB_* values are then never read at all.
#
# For Neon, use the DIRECT endpoint, not the one with "-pooler" in the host.
# Django keeps its own connections (conn_max_age=600), while the pooler does
# transaction pooling and leaks session state between clients, which can leave
# search_path empty and break every unqualified query.
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

DB_NAME=employee_management
DB_USER=employee_app
DB_PASSWORD=replace-with-your-local-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Optional server-wide invitation email. Leave EMAIL_HOST blank to let each
# employer add their own Gmail App Password under Settings instead.
# For Gmail, use an App Password, not your normal password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
DEFAULT_FROM_EMAIL=you@gmail.com

# Brevo sends over HTTPS, for hosts that block SMTP. When BREVO_API_KEY is set
# it replaces Gmail for all email. DEFAULT_FROM_EMAIL must be a Brevo-verified sender.
BREVO_API_KEY=
# DEFAULT_FROM_EMAIL=Employee Management <you@gmail.com>

# Where invitation emails tell employees to sign in.
FRONTEND_URL=http://localhost:5173

# Settings for an enrolled physical ESP32 controller.
# Never commit the per-device secret.
# The controller addresses Django by IP, so that IP has to be allowed or Django
# answers 400 DisallowedHost. 192.168.137.1 is the Windows Mobile Hotspot
# gateway; add your own LAN address if the board joins an existing network.
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.137.1
DOOR_GATEWAY=api.door_gateway.PhysicalDoorGateway
DOOR_COMMAND_TTL_SECONDS=8
DOOR_DEVICE_OFFLINE_SECONDS=10
DOOR_SIGNATURE_WINDOW_SECONDS=60
# DOOR_DEVICE_SECRET is consumed only by the enroll_door_device command, which
# hashes it and never stores the raw value.
# DOOR_DEVICE_SECRET=

# Used only by `python manage.py seed` / `ensure_platform_admin` to create the
# platform super admin (username "admin"). Uncomment and set a real password,
# then remove it once the account exists.
# PLATFORM_ADMIN_PASSWORD=replace-with-a-strong-password
